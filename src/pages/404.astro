---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Page introuvable" description="Cette page n'existe pas.">
  <div class="max-w-xl mx-auto px-6 py-32 text-center">
    <p class="text-sm font-bold tracking-widest uppercase mb-6" style="color:var(--primary-600)">404</p>
    <h1 class="text-2xl font-bold text-slate-900 mb-4">Cette page n'existe pas.</h1>
    <p class="text-slate-500 text-base leading-relaxed mb-10">
      L'écart entre l'intention et l'exécution, en revanche, existe partout.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href={`${base}framework/these/`} class="btn-primary">Lire la thèse →</a>
      <a href={base} class="btn-secondary">Retour à l'accueil</a>
    </div>
  </div>
</Layout>
